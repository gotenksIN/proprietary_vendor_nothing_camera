type noth_camera_app, domain;

app_domain(noth_camera_app)

hal_client_domain(noth_camera_app, vendor_hal_noth_camera)
hal_client_domain(noth_camera_app, vendor_hal_perf)

r_dir_file(noth_camera_app, vendor_richtap_resources)

# Privileged camera app service access.
allow noth_camera_app {
    app_api_service
    audioserver_service
    cameraserver_service
    mediaserver_service
}:service_manager find;
